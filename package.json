{
    "name": "@designliquido/delegua-interface-grafica",
    "version": "0.0.1",
    "description": "Biblioteca de interface gráfica para Delégua",
    "main": "index.js",
    "types": "index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DesignLiquido/delegua-interface-grafica.git"
    },
    "scripts": {
        "empacotar": "yarn rimraf ./dist && tsc && yarn copyfiles -V ./README.md ./dist && yarn copyfiles -V ./LICENSE ./dist && yarn copyfiles -V ./package.json ./dist",
        "publicar-npm": "npm publish --access public",
        "testes-unitarios": "yarn jest --coverage",
        "host-java-swing:jar": "gradle -p host-java-swing fatJar",
        "testes-e2e-java-swing": "node scripts/rodar-teste-e2e-java-swing.js",
        "host-gtk:build": "cargo build --release --manifest-path host-gtk/Cargo.toml",
        "testes-e2e-gtk": "node scripts/rodar-teste-e2e-gtk.js",
        "host-macos:build": "swift build --package-path host-macos -c release",
        "host-windows:publish": "dotnet publish host-windows/DeleguaInterfaceGraficaWindowsHost.csproj -c Release -r win-x64 --self-contained false -o host-windows/publish",
        "testes-e2e-windows": "node scripts/rodar-teste-e2e-windows.js",
        "lint": "yarn eslint . --ext .ts --fix"
    },
    "keywords": [
        "delegua",
        "interface",
        "gui",
        "janela"
    ],
    "author": "Leonel Sanches da Silva",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "peerDependencies": {
        "@designliquido/delegua": ">=1.15.1"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.14.0",
        "copyfiles": "^2.4.1",
        "jest": "^29.7.0",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.3.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
