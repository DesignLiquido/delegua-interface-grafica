{
    "compilerOptions": {
        "outDir": "dist",
        "module": "CommonJS",
        "target": "ES2020",
        "lib": ["ES2020", "dom"],
        "rootDir": "fontes",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "coverage",
        "dist",
        "jest.config.ts",
        "node_modules",
        "scripts",
        "host-gtk",
        "host-java-swing",
        "host-windows",
        "testes"
    ]
}
